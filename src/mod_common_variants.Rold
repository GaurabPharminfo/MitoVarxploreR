library(shiny)
library(bslib)
library(dplyr)
library(DT)
library(htmltools)
library(tidyr)

commonVariantsUI <- function(id) {
  ns <- NS(id)
  
  layout_sidebar(
    sidebar = sidebar(
      title = "Filters & Tools",
      width = 300,
      
      p(strong("Views")),
      actionButton(ns("view_default"), "Default Table", class = "btn-outline-primary mb-2"),
      actionButton(ns("view_summary"), "Summarise", class = "btn-outline-info mb-2"),
      actionButton(ns("view_breakup"), "Patient Breakup", class = "btn-outline-primary"),
      hr(),
      
      textInput(ns("search_gene"), "Search Gene:", placeholder = "e.g., MT-ND1"),
      hr(),
      
      downloadButton(ns("download_csv"), "Download Current View", class = "btn-success")
    ),
    
    tags$head(
      tags$style(HTML("
        .dataTables_wrapper { font-size: 13px; }
        table.dataTable { white-space: nowrap; } 
        .card-header { font-weight: 600; font-size: 1.1rem; background-color: #f8f9fa; }
        .dt-buttons { margin-bottom: 10px; }
      "))
    ),
    
    uiOutput(ns("main_content"))
  )
}

commonVariantsServer <- function(id, db_path, con) {
  moduleServer(id, function(input, output, session) {
    
    current_view <- reactiveVal("default")
    
    observeEvent(input$view_default, current_view("default"))
    observeEvent(input$view_summary, current_view("summary"))
    observeEvent(input$view_breakup, current_view("breakup"))
    
    observeEvent(db_path(), {
      req(db_path())
      var_path  <- file.path(db_path(), "variants", "*.parquet")
      anno_path <- file.path(db_path(), "annotations", "*.parquet")
      map_path  <- file.path(db_path(), "metadata", "*.parquet")
      
      try({
        dbExecute(con, paste0("CREATE OR REPLACE VIEW variants AS SELECT * FROM read_parquet('", var_path, "')"))
        dbExecute(con, paste0("CREATE OR REPLACE VIEW annotations AS SELECT * FROM read_parquet('", anno_path, "')"))
        dbExecute(con, paste0("CREATE OR REPLACE VIEW sample_map AS SELECT * FROM read_parquet('", map_path, "')"))
      }, silent = TRUE)
    })
    
    base_data <- reactive({
      req(db_path())
      
      # 1. Find the total number of unique samples available
      total_samples <- tbl(con, "annotations") %>%
        summarise(n = n_distinct(Sample_ID)) %>%
        collect() %>%
        pull(n)
      
      # 2. Identify variants present in ALL samples (100% presence)
      common_vars <- tbl(con, "annotations") %>%
        group_by(VariantID) %>%
        summarise(sample_count = n_distinct(Sample_ID), .groups = "drop") %>%
        filter(sample_count == !!total_samples) %>%
        select(VariantID)
      
      # 3. Base Query: Pre-filter using inner_join with common_vars
      query <- common_vars %>%
        inner_join(tbl(con, "variants"), by = "VariantID") %>%
        left_join(tbl(con, "annotations"), by = c("VariantID")) %>%
        left_join(tbl(con, "sample_map"), by = c("Sample_ID" = "GRG"))
      
      if (isTruthy(input$search_gene)) {
        search_term <- paste0("%", toupper(input$search_gene), "%")
        query <- query %>% filter(upper(Gene.ensGene) %like% !!search_term)
      }
      
      query
    })
    
    data_default <- reactive({
      base_data() %>% 
        mutate(Variant = paste(CHROM, ".", POS, paste(REF, ">", ALT))) %>%
        dplyr::select(Variant, VariantID, CHROM, POS, REF, ALT, Gene.ensGene, Func.ensGene) %>%
        collect() %>% unique()
    })
    
    data_summary <- reactive({
      base_data() %>% 
        mutate(Variant = paste(CHROM, ".", POS, paste(REF, ">", ALT))) %>%
        dplyr::select(VariantID, Variant, CHROM, POS, REF, ALT, Gene.ensGene, Func.ensGene, NAME, GROUP) %>%
        dplyr::group_by(VariantID, Variant, CHROM, POS, REF, ALT, Gene.ensGene, Func.ensGene, GROUP) %>%
        dplyr::summarise(`No of patients` = n(), .groups = 'drop') %>%
        collect()
    })
    
    data_group_summary <- reactive({
      base_data() %>%
        mutate(Variant = paste(CHROM, ".", POS, paste(REF, ">", ALT))) %>%
        dplyr::select(Variant, GROUP, NAME) %>%
        distinct() %>%
        dplyr::group_by(Variant, GROUP) %>%
        dplyr::summarise(Count = n(), .groups = 'drop') %>%
        collect() %>%
        tidyr::pivot_wider(names_from = GROUP, values_from = Count, values_fill = 0)
    })
    
    data_breakup <- reactive({
      raw_data <- base_data() %>% 
        mutate(Variant = paste(CHROM, ".", POS, paste(REF, ">", ALT))) %>%
        collect()
      
      req(nrow(raw_data) > 0)
      raw_data <- raw_data %>% filter(!is.na(NAME))
      
      patient_metrics <- c("AD", "AF", "AN", "AC_hom", "AC_het", "AF_hom", "AF_het", "zygosity")
      
      for (col in patient_metrics) {
        if (!col %in% names(raw_data)) raw_data[[col]] <- NA
      }
      
      wide_data <- raw_data %>%
        tidyr::pivot_wider(
          id_cols = c("VariantID", "Variant", "Gene.ensGene", "Func.ensGene"),
          names_from = NAME,
          values_from = all_of(patient_metrics),
          names_glue = "{NAME}___{.value}"
        )
      
      patients <- sort(unique(raw_data$NAME))
      col_order <- c("VariantID", "Variant", "Gene.ensGene", "Func.ensGene")
      for (p in patients) {
        col_order <- c(col_order, paste0(p, "___", patient_metrics))
      }
      
      wide_data %>% dplyr::select(all_of(col_order))
    })
    
    output$main_content <- renderUI({
      view <- current_view()
      if (view == "default") {
        tagList(h3("Common Variants"), DTOutput(session$ns("table_default")))
        
      } else if (view == "summary") {
        tagList(
          h3("Common Variants - Summary"),
          layout_columns(
            col_widths = c(7, 5),
            card(
              full_screen = TRUE,
              card_header("Variants Breakdown"),
              DTOutput(session$ns("table_summary"))
            ),
            card(
              full_screen = TRUE,
              card_header(
                class = "d-flex justify-content-between align-items-center",
                "Variant by Sample Group",
                downloadButton(session$ns("download_group"), "Download", class = "btn-secondary btn-sm")
              ),
              DTOutput(session$ns("table_group_summary"))
            )
          )
        )
        
      } else if (view == "breakup") {
        tagList(h3("Common Variants - Patient Breakup"), DTOutput(session$ns("table_breakup")))
      }
    })
    
    output$table_default <- renderDT({
      datatable(data_default(), class = 'display compact nowrap', width = "100%", options = list(pageLength = 20, scrollX = TRUE, autoWidth = FALSE))
    })
    
    output$table_summary <- renderDT({
      datatable(data_summary(), class = 'display compact nowrap', width = "100%", options = list(pageLength = 20, scrollX = TRUE, autoWidth = FALSE))
    })
    
    output$table_group_summary <- renderDT({
      datatable(data_group_summary(), class = 'display compact nowrap', width = "100%", options = list(pageLength = 20, scrollX = TRUE, autoWidth = FALSE))
    })
    
    output$table_breakup <- renderDT({
      wide_data <- data_breakup()
      req(nrow(wide_data) > 0)
      
      patient_metrics <- c("AD", "AF", "AN", "AC_hom", "AC_het", "AF_hom", "AF_het", "zygosity")
      all_metric_cols <- names(wide_data)[-(1:4)]
      patients <- unique(sub("___.*", "", all_metric_cols))
      
      th_top <- list(
        tags$th(rowspan = 2, 'VariantID'),
        tags$th(rowspan = 2, 'Variant'),
        tags$th(rowspan = 2, 'Gene.ensGene'),
        tags$th(rowspan = 2, 'Func.ensGene')
      )
      
      for (p in patients) {
        th_top <- c(th_top, list(tags$th(colspan = length(patient_metrics), p, class = 'dt-center')))
      }
      
      th_bottom <- lapply(rep(patient_metrics, length(patients)), tags$th)
      
      sketch <- tags$table(
        class = 'display compact nowrap',
        tags$thead(tags$tr(th_top), tags$tr(th_bottom))
      )
      
      datatable(
        wide_data,
        class = 'display compact nowrap',
        width = "100%",
        container = sketch,
        rownames = FALSE,
        options = list(pageLength = 20, scrollX = TRUE, autoWidth = FALSE)
      )
    })
    
    output$download_csv <- downloadHandler(
      filename = function() { paste0("MitoVar_Common_Export_", current_view(), "_", Sys.Date(), ".csv") },
      content = function(file) {
        view <- current_view()
        export_data <- if (view == "default") {
          data_default()
        } else if (view == "summary") {
          data_summary()
        } else if (view == "breakup") {
          df <- data_breakup()
          names(df) <- gsub("___", "_", names(df))
          df
        }
        write.csv(export_data, file, row.names = FALSE)
      }
    )
    
    output$download_group <- downloadHandler(
      filename = function() { paste0("MitoVar_Common_Group_Summary_", Sys.Date(), ".csv") },
      content = function(file) { write.csv(data_group_summary(), file, row.names = FALSE) }
    )
    
  })
}